{
  "name": "strapi-plugin-dynamic-form-builder",
  "version": "1.0.0",
  "description": "Build and manage multilingual dynamic forms in Strapi with nested fields and a Content API.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "plugin",
    "form",
    "form-builder",
    "dynamic-form"
  ],
  "license": "MIT",
  "author": {
    "name": "BrainStation-23",
    "url": "https://github.com/BrainStation-23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainStation-23/strapi-dynamic-form-builder.git"
  },
  "bugs": {
    "url": "https://github.com/BrainStation-23/strapi-dynamic-form-builder/issues"
  },
  "homepage": "https://github.com/BrainStation-23/strapi-dynamic-form-builder#readme",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "pack": "node ./pack.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.16.0",
    "prettier": "^3.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.19"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.16.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "strapi": {
    "kind": "plugin",
    "name": "form-builder",
    "displayName": "Dynamic Form Builder",
    "description": "Build and manage multilingual dynamic forms in Strapi with nested fields and a Content API."
  }
}
